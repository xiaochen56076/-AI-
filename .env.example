DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Development defaults to SQLite. Set DB_ENGINE=mysql to use MySQL.
DB_ENGINE=sqlite
DB_NAME=campushub
DB_USER=campushub
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=3306

# Optional. Without Redis, the app uses local-memory cache and database-backed tasks.
REDIS_URL=
CELERY_BROKER_URL=
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
